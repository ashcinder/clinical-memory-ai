HOST=127.0.0.1
# 开发配置。正式内网部署使用 deploy/intranet/clinical-memory.env.example，详见同目录 README。
# Nginx 同机时后端保持 127.0.0.1，客户端统一访问内网 HTTPS 入口。
PORT=8000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=linji
DB_USER=linji
DB_PASSWORD=请填写你创建的MySQL应用用户密码
# 可选：使用 Unix socket 时填写，如 /tmp/mysql.sock；填写后忽略 DB_HOST / DB_PORT
DB_SOCKET=
# 仅后端保存 API 密钥。选择 deepseek / glm / kimi / minimax / none。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4.5
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash
# 视觉服务可独立于对话服务：deepseek / glm / kimi / minimax / none。
# 选择任一服务时请填写支持图片输入的模型。
VISION_PROVIDER=deepseek
VISION_MODEL=deepseek-flash
# 可选覆盖视觉服务密钥及基础地址；不填这一行则使用所选服务的对应密钥。
# VISION_API_KEY=
# VISION_BASE_URL=
# 音频转写使用独立的 OpenAI 兼容 ASR 服务。
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1
COOKIE_SECURE=false
# 默认为项目下的 数据库数据；只存附件和备份，不存 MySQL 引擎文件。
# DATA_DIR=/absolute/path/to/data
# Web 独立启动时填端口，例如 5173。仅在本机监听。
WEB_PORT=5173

# 可选：本地识别模型路径（引擎由 setup-local-search.sh 准备）
# LOCAL_ASR_MODEL=/absolute/path/to/ggml-base.bin
# OCR_DATA_DIR=/absolute/path/to/tessdata

# 多项目部署时为本项目设置独立访问路径；本地默认留空
PUBLIC_BASE_PATH=
