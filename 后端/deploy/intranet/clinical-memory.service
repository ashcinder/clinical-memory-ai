[Unit]
Description=Clinical Memory intranet application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clinicalmemory
Group=clinicalmemory
WorkingDirectory=/srv/clinical-memory/current/后端
EnvironmentFile=/etc/clinical-memory/clinical-memory.env
Environment=PATH=/srv/clinical-memory/tools/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/clinical-memory/current/后端/bin/linji-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clinical-memory

[Install]
WantedBy=multi-user.target
