# Copy to /etc/clinical-memory/clinical-memory.env (root:root, 0600).
# Parsed by systemd EnvironmentFile, not a shell script. Do not use export or $VAR.
PROJECT_ROOT=/srv/clinical-memory/current
DATA_DIR=/var/lib/clinical-memory
HOST=127.0.0.1
PORT=18090
PUBLIC_BASE_PATH=/clinical-memory
COOKIE_SECURE=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_NAME=clinical_memory
DB_USER=clinicalmemory
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
VISION_PROVIDER=none
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1
# Optional local engines must be installed separately; see README.md.
LOCAL_ASR_MODEL=/var/lib/clinical-memory/models/ggml-base.bin
OCR_DATA_DIR=/var/lib/clinical-memory/models/tessdata
# Optional outbound proxy understood by Go's HTTP client:
# HTTPS_PROXY=http://proxy.your-organization.example:3128
# NO_PROXY=localhost,127.0.0.1,::1
# Optional additional CA bundle for outbound AI gateways (not the Nginx key):
# SSL_CERT_FILE=/etc/clinical-memory/outbound-ca-bundle.pem
